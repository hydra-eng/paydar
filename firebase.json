{
  "hosting": {
    "site": "paydar",
    "public": "site/dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ],
    "redirects": [
      {
        "source": "/downloads/PayDar-beta.apk",
        "destination": "https://raw.githubusercontent.com/hydra-eng/paydar/main/site/dist/downloads/PayDar-beta.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "paydar.web.app",
      "paydar.firebaseapp.com",
      "paydar-hydra.web.app",
      "paydar-hydra.firebaseapp.com"
    ],
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "PayDar",
        "supportEmail": "hydra00x@gmail.com"
      }
    }
  }
}
